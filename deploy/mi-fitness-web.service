[Unit]
Description=Mi Fitness Web Dashboard
Wants=mi-fitness-api.service
After=network-online.target mi-fitness-api.service

[Service]
Type=simple
User=mifitness
Group=mifitness
WorkingDirectory=/opt/mi-fitness-mcp-cn/app
EnvironmentFile=/etc/mi-fitness-mcp/runtime.env
ExecStart=/opt/mi-fitness-mcp-cn/.venv/bin/gunicorn --bind 127.0.0.1:8322 --workers 1 --threads 4 --timeout 360 --access-logfile /dev/null mi_fitness_mcp.web:create_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=mi-fitness-mcp
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
